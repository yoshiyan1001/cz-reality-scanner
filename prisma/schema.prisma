// Reality Scanner CZ — Prague real estate meta-search with PostGIS proximity filtering.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) Neon connection for prisma migrate.
  directUrl  = env("DATABASE_URL_UNPOOLED")
  // Declaring PostGIS stops `prisma migrate` from treating its objects
  // (e.g. the spatial_ref_sys table) as drift.
  extensions = [postgis]
}

/// Prague Metro lines: A = green, B = yellow, C = red.
enum MetroLine {
  A
  B
  C
}

/// One row per station *per line*: transfer stations (Můstek, Muzeum, Florenc)
/// appear once for each line they serve.
model MetroStation {
  id        Int                                   @id @default(autoincrement())
  name      String
  line      MetroLine
  lineColor String                                @map("line_color")
  latitude  Float
  longitude Float
  /// WGS84 point (lon, lat). Written via raw SQL; Prisma can't read/write it directly.
  location  Unsupported("geometry(Point, 4326)")

  @@unique([name, line])
  @@index([line])
  @@index([location], type: Gist)
}

model PhysicalProperty {
  id          Int                                   @id @default(autoincrement())
  title       String
  address     String
  district    String
  disposition String /// Czech layout notation, e.g. "1+kk", "2+1"
  areaM2      Float
  priceCzk    Int
  /// WGS84 point (lon, lat). Written via raw SQL; Prisma can't read/write it directly.
  location    Unsupported("geometry(Point, 4326)")
  createdAt   DateTime                              @default(now())

  @@index([location], type: Gist)
}
